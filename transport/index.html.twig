                        </div>
                      </template>

                      <div x-show="(current.ships || []).length === 0" class="text-white/55 italic border border-dashed border-white/10 rounded-xl p-4 bg-white/[0.02]">
                        Aucun vaisseau sélectionné.
                      </div>
                    </div>

                  </div>
                </div>

                <!-- Actions -->
                <div class="pt-2 flex flex-wrap items-center gap-2">
                  <button
                    @click="goToList()"
                    class="px-4 py-2 rounded-xl font-semibold text-white/90 bg-white/5 border border-white/10 hover:bg-white/10"
                  >Retour liste</button>
                </div>

              </div>
            </div>

            <!-- LIGNES TAB -->
            <div x-show="editTab==='lines'" x-transition
                class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.03)]">

              <div class="flex items-center justify-between gap-3 mb-4">
                <div>
                  <h3 class="font-semibold tracking-wide">Lignes de livraison</h3>
                  <div class="text-xs text-white/45">Pickup → Dropoff · Quantité · Cargaison · Caisse max</div>
                </div>
                <button
                  @click="addLine(); $nextTick(() => $refs.manifestList.scrollTop = 0)"
                  class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg font-semibold text-[#071018] bg-emerald-300 hover:brightness-110 active:brightness-95"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                  Ajouter
                </button>
              </div>

              {# IMPORTANT: plus de overflow-y-auto ici -> les dropdowns peuvent dépasser #}
              <div x-ref="manifestList" class="max-h-[65vh] overflow-y-auto pr-2 space-y-3">
                <template x-for="(manifest, idx) in (current.manifests || [])" :key="manifest._k">
                  <div class="rounded-xl border border-white/10 bg-white/[0.02] p-4 space-y-3">

                    <!-- Header : numéro + type + actions -->
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-3">
                        <span class="text-xs text-white/40 font-semibold uppercase tracking-wider" x-text="'Mission ' + (idx + 1)"></span>
                        <!-- Mission type selector -->
                        <div class="flex items-center gap-1 rounded-xl border border-white/10 bg-white/[0.03] overflow-hidden text-xs">
                          <template x-for="(label, val) in { mono_route: 'A→B', multi_drop: 'A→B+C', multi_pickup: 'A+B→C', multi_route: 'A+B→C+D' }">
                            <button
                              type="button"
                              @click="manifest.type = val"
                              :class="manifest.type === val ? 'bg-sky-400/20 text-sky-200 border-sky-400/30' : 'text-white/50 hover:bg-white/5 border-transparent'"
                              class="px-2.5 py-1 font-semibold border transition"
                              x-text="label"
                            ></button>
                          </template>
                        </div>
                        <span
                          x-show="manifest.type && manifest.type !== 'mono_route'"
                          class="text-[10px] px-2 py-0.5 rounded-full border bg-amber-400/10 border-amber-400/20 text-amber-300"
                          x-text="{
                            multi_drop:    '1 pickup · N dropoffs',
                            multi_pickup:  'N pickups · 1 dropoff',
                            multi_route:   'N pickups · N dropoffs'
                          }[manifest.type] ?? ''"
                        ></span>
                      </div>
                      <div class="flex items-center gap-2">
                        <button
                          type="button"
                          @click="duplicateLine(idx)"
                          class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-xs font-semibold text-white/70 bg-sky-400/10 border border-sky-400/20 hover:bg-sky-400/15 transition"
                          title="Dupliquer ce manifeste"
                        >
                          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                          Dupliquer
                        </button>
                        <button
                          type="button"
                          @click="removeManifest(idx)"
                          class="p-1.5 rounded-lg text-red-400/60 hover:text-red-400 hover:bg-red-400/10 transition"
                          title="Supprimer ce manifeste"
                        >
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                      </div>
                    </div>

                    <!-- Taille max des caisses (optionnel, niveau mission) -->
                    <div class="flex items-center gap-3">
                      <label class="text-xs uppercase tracking-wider text-white/55 whitespace-nowrap">Caisse max</label>
                      <div class="flex items-center gap-1">
                        <input
                          type="number"
                          min="1"
                          step="1"
                          x-model.number="manifest.maxBoxSize"
                          class="w-24 rounded-xl bg-[#070c14]/70 border border-white/10 px-3 py-1.5 text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-sky-400/30 focus:border-sky-400/30 text-sm"
                          placeholder="— SCU"
                        />
                        <span class="text-xs text-white/35">SCU</span>
                        <button
                          type="button"
                          x-show="manifest.maxBoxSize"
                          @click="manifest.maxBoxSize = null"
                          class="p-1 rounded-lg text-white/30 hover:text-white/60 hover:bg-white/5 transition text-xs"
                          title="Retirer la limite"
                        >✕</button>
                      </div>
                    </div>

                    <!-- Manifest-level pickup (shown for mono_route and multi_drop) -->
                    <div x-show="manifest.type === 'mono_route' || manifest.type === 'multi_drop'">
                      <span class="text-xs uppercase tracking-wider text-white/55">
                        Pickup
                        <span x-show="manifest.type === 'multi_drop'" class="text-white/35 normal-case tracking-normal ml-1">(partagé par toutes les cargaisons)</span>
                      </span>
                      <div class="relative mt-1">
                        <input
                          type="text"
                          :value="poiSearches[`pickup_${manifest._k}`].query"
                          @input="onFieldInput('poi', `pickup_${manifest._k}`, $event.target)"
                          class="w-full rounded-xl bg-[#070c14]/70 border border-white/10 px-3 py-2 text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-sky-400/30 focus:border-sky-400/30"
                          placeholder="Ex: Everus Harbor"
                        />
                      </div>
                    </div>

                    <!-- Manifest-level dropoff (shown for mono_route and multi_pickup) -->
                    <div x-show="manifest.type === 'mono_route' || manifest.type === 'multi_pickup'">
                      <span class="text-xs uppercase tracking-wider text-white/55">
                        Dropoff
                        <span x-show="manifest.type === 'multi_pickup'" class="text-white/35 normal-case tracking-normal ml-1">(partagé par toutes les cargaisons)</span>
                      </span>
                      <div class="relative mt-1">
                        <input
                          type="text"
                          :value="poiSearches[`dropoff_${manifest._k}`].query"
                          @input="onFieldInput('poi', `dropoff_${manifest._k}`, $event.target)"
                          class="w-full rounded-xl bg-[#070c14]/70 border border-white/10 px-3 py-2 text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-sky-400/30 focus:border-sky-400/30"
                          placeholder="Ex: Seraphim Station"
                        />
                      </div>
                    </div>

                    <!-- Cargaisons -->
                    <div class="space-y-2">
                      <div class="flex items-center justify-between">
                        <span class="text-xs uppercase tracking-wider text-white/55">Cargaisons</span>
                        <button
                          type="button"
                          @click="addCargo(manifest._k)"
                          class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-xs font-semibold text-[#071018] bg-emerald-300/80 hover:brightness-110 active:brightness-95"
                        >
                          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                          Ajouter
                        </button>
                      </div>
                      <template x-for="(cargo, ci) in (manifest.cargos || [])" :key="cargo._k">
                        <div class="rounded-xl border border-white/[0.08] bg-white/[0.01] p-3 space-y-2">
                          <div class="flex items-center gap-2">
                            <!-- Commodity -->
                            <div class="flex-1">
                              <input
                                type="text"
                                :value="commoditySearches[`commodity_${manifest._k}_${cargo._k}`]?.query ?? cargo.commodityName"
                                @input="onFieldInput('commodity', `commodity_${manifest._k}_${cargo._k}`, $event.target)"
                                class="w-full rounded-xl bg-[#070c14]/70 border border-white/10 px-3 py-2 text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-sky-400/30 focus:border-sky-400/30 text-sm"
                                placeholder="Cargaison…"
                              />
                            </div>
                            <!-- Quantité -->
                            <div class="w-24">
                              <input
                                type="number"
                                min="0"
                                step="1"
                                x-model.number="cargo.quantity"
                                class="w-full rounded-xl bg-[#070c14]/70 border border-white/10 px-3 py-2 text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-sky-400/30 focus:border-sky-400/30 text-sm"
                                placeholder="SCU"
                              />
                            </div>
                            <!-- Retirer -->
                            <button
                              type="button"
                              x-show="(manifest.cargos || []).length > 1"
                              @click="removeCargo(manifest._k, cargo._k)"
                              class="p-1.5 rounded-lg text-red-400/70 hover:text-red-400 hover:bg-red-400/10 transition"
                              title="Retirer cette cargaison"
                            >
                              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                            </button>
                          </div>

                          <!-- Per-cargo pickup (for multi_pickup and multi_route) -->
                          <div x-show="manifest.type === 'multi_pickup' || manifest.type === 'multi_route'" class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div>
                              <span class="text-[11px] uppercase tracking-wider text-emerald-300/70">Pickup cargaison</span>
                              <div class="relative mt-1">
                                <input
                                  type="text"
                                  :value="poiSearches[`cargo_pickup_${manifest._k}_${cargo._k}`]?.query ?? cargo.pickupName ?? ''"
                                  @input="onFieldInput('poi', `cargo_pickup_${manifest._k}_${cargo._k}`, $event.target)"
                                  class="w-full rounded-xl bg-[#070c14]/70 border border-emerald-400/20 px-3 py-1.5 text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-emerald-400/30 text-sm"
                                  placeholder="Ex: Everus Harbor"
                                />
                              </div>
                            </div>

                            <!-- Per-cargo dropoff (multi_route only — alongside pickup) -->
                            <div x-show="manifest.type === 'multi_route'">
                              <span class="text-[11px] uppercase tracking-wider text-orange-300/70">Dropoff cargaison</span>
                              <div class="relative mt-1">
                                <input
                                  type="text"
                                  :value="poiSearches[`cargo_dropoff_${manifest._k}_${cargo._k}`]?.query ?? cargo.dropoffName ?? ''"
                                  @input="onFieldInput('poi', `cargo_dropoff_${manifest._k}_${cargo._k}`, $event.target)"
                                  class="w-full rounded-xl bg-[#070c14]/70 border border-orange-400/20 px-3 py-1.5 text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-orange-400/30 text-sm"
                                  placeholder="Ex: Seraphim Station"
                                />
                              </div>
                            </div>
                          </div>

                          <!-- Per-cargo dropoff (for multi_drop — single column) -->
                          <div x-show="manifest.type === 'multi_drop'">
                            <span class="text-[11px] uppercase tracking-wider text-orange-300/70">Dropoff cargaison</span>
                            <div class="relative mt-1">
                              <input
                                type="text"
                                :value="poiSearches[`cargo_dropoff_${manifest._k}_${cargo._k}`]?.query ?? cargo.dropoffName ?? ''"
                                @input="onFieldInput('poi', `cargo_dropoff_${manifest._k}_${cargo._k}`, $event.target)"
                                class="w-full rounded-xl bg-[#070c14]/70 border border-orange-400/20 px-3 py-1.5 text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-orange-400/30 text-sm"
                                placeholder="Ex: Seraphim Station"
                              />
                            </div>
                          </div>
                        </div>
                      </template>
                    </div>

                    <!-- Saisie rapide par collage -->
                    <div class="pt-1">
                      <button
                        type="button"
                        @click="pasteMode[manifest._k] ??= { open: false, text: '', errors: [] }; pasteMode[manifest._k].open = !pasteMode[manifest._k].open"
                        class="inline-flex items-center gap-1 text-xs text-white/40 hover:text-white/70 transition"
                      >
                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        <span x-text="pasteMode[manifest._k]?.open ? 'Fermer la saisie rapide' : 'Saisie rapide (coller une liste)'"></span>
                      </button>

                      <div x-show="pasteMode[manifest._k]?.open" class="mt-2 space-y-2">
                        <textarea
                          x-model="(pasteMode[manifest._k] ??= { open: true, text: '', errors: [] }).text"
                          rows="4"
                          class="w-full rounded-xl bg-[#070c14]/70 border border-white/10 px-3 py-2 text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-sky-400/30 focus:border-sky-400/30 font-mono text-sm resize-y"
                          placeholder="Iron 100&#10;Copper 50&#10;Titanium 75"
                        ></textarea>
                        <div class="flex items-center gap-2">
                          <button
                            type="button"
                            @click="(pasteMode[manifest._k] ??= { open: true, text: '', errors: [] }).open = true; pasteMode[manifest._k].text = getPasteExample(manifest.type); pasteMode[manifest._k].errors = []"
                            title="Insère un exemple de saisie rapide dans le champ"
                            class="px-2 py-1 rounded-lg text-xs font-medium text-white/80 bg-white/5 border border-white/8 hover:bg-white/10"
                          >Exemple</button>

                          <button
                            type="button"
                            @click="parsePasteText(manifest._k, pasteMode[manifest._k]?.text).then(errs => { pasteMode[manifest._k].errors = errs || [] })"
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold text-[#071018] bg-emerald-300 hover:brightness-110 active:brightness-95"
                          >Importer</button>

                          <button
                            type="button"
                            @click="pasteMode[manifest._k].text = ''; pasteMode[manifest._k].errors = []"
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white/60 bg-white/5 border border-white/10 hover:bg-white/10"
                          >Effacer</button>
                        </div>

                        <div class="text-xs text-white/50 mt-2">
                          <div><strong>Formats supportés :</strong></div>
                          <ul class="list-inside list-disc ml-3">
                            <li>"Iron 100" — cargaison simple</li>
                            <li>"Iron 100 | Pickup | Dropoff" — préciser pickup et/ou dropoff</li>
                            <li>"Iron 100 @Pickup -> Dropoff" — notation inline pour pickup et dropoff</li>
                          </ul>
                          <div class="mt-1">Pour les missions <em>multi_*</em>, fournissez les POI par cargaison (via syntaxe ci‑dessus) ou éditez chaque cargo après import.</div>
                        </div>
                        <template x-if="(pasteMode[manifest._k]?.errors || []).length > 0">
                          <div class="space-y-1">
                            <template x-for="(e, ei) in pasteMode[manifest._k].errors" :key="ei">
                              <div class="text-xs text-red-300 bg-red-950/30 border border-red-500/20 rounded-lg px-3 py-1.5" x-text="e"></div>
                            </template>
                          </div>
                        </template>
                      </div>
                    </div>

                  </div>
                </template>

                <div x-show="(current.manifests || []).length === 0"
                    class="text-white/55 italic border border-dashed border-white/10 rounded-xl p-4 bg-white/[0.02]">
                  Aucune ligne de livraison. Ajoute au moins une ligne.
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT (summary) -->
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.03)]">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-semibold tracking-wide">Résumé</h3>
              <span class="text-[11px] px-2 py-1 rounded-full bg-white/5 border border-white/10 text-white/70">PREVIEW</span>
            </div>

            <div class="space-y-3 text-sm">
              <div class="rounded-xl border border-white/10 bg-[#070c14]/55 p-3">
                <div class="text-xs text-white/45 uppercase tracking-wider">Nom</div>
                <div class="font-semibold mt-1 truncate" x-text="current.name || '—'"></div>
              </div>

              <div class="rounded-xl border border-white/10 bg-[#070c14]/55 p-3">
                <div class="text-xs text-white/45 uppercase tracking-wider">Départ</div>
                <div class="font-semibold mt-1 truncate" x-text="current.originName || '—'"></div>
              </div>

              <div class="rounded-xl border border-white/10 bg-[#070c14]/55 p-3">
                <div class="text-xs text-white/45 uppercase tracking-wider">Flotte</div>
                <div class="mt-2 space-y-2 max-h-[28vh] overflow-y-auto pr-2">
                  <template x-for="(ship, idx) in (current.ships || [])" :key="idx + '_sum_' + ship.shipId">
                    <div class="text-xs text-white/65 border border-white/10 rounded-lg p-2 bg-white/[0.02]">
                      <div class="font-semibold text-white/80" x-text="shipModelName(ship.shipId)"></div>
                      <div x-show="ship.note" class="mt-1 text-white/55 italic" x-text="'Note: ' + ship.note"></div>
                    </div>
                  </template>
                  <div x-show="(current.ships || []).length === 0" class="text-white/55 italic">— aucun vaisseau —</div>
                </div>
              </div>

              <div class="rounded-xl border border-white/10 bg-[#070c14]/55 p-3">
                <div class="text-xs text-white/45 uppercase tracking-wider">Lignes</div>
                <div class="mt-2 space-y-2 max-h-[45vh] overflow-y-auto pr-2">
                  <template x-for="(line, idx) in (current.manifests || [])" :key="line._k + '_sum'">
                    <div class="text-xs text-white/65 border border-white/10 rounded-lg p-2 bg-white/[0.02]">
                      <div class="font-semibold text-white/80 truncate flex items-center gap-2">
                        <span x-text="'M' + (idx+1)"></span>
                        <span
                          class="inline-flex px-1.5 py-0.5 rounded text-[10px] border"
                          :class="{
                            'mono_route':  'bg-white/5 border-white/10 text-white/50',
                            'multi_drop':  'bg-orange-400/10 border-orange-400/20 text-orange-300',
                            'multi_pickup':'bg-emerald-400/10 border-emerald-400/20 text-emerald-300',
                            'multi_route': 'bg-sky-400/10 border-sky-400/20 text-sky-300',
                          }[line.type ?? 'mono_route'] ?? 'bg-white/5 border-white/10 text-white/50'"
                          x-text="{ mono_route:'A→B', multi_drop:'A→B+C', multi_pickup:'A+B→C', multi_route:'A+B→C+D' }[line.type ?? 'mono_route'] ?? line.type"
                        ></span>
                        <span x-text="(line.pickupName || '…') + ' → ' + (line.dropoffName || '…')"></span>
                      </div>
                      <div class="mt-1 space-y-0.5">
                        <template x-for="c in (line.cargos || [])" :key="c._k">
                          <div class="text-white/55">
                            <span class="text-white/75" x-text="c.commodityName || '—'"></span>
                            <span x-show="c.quantity"> · <span x-text="c.quantity"></span> SCU</span>
                            <span x-show="c.pickupName" class="text-emerald-300/70"> · ↑ <span x-text="c.pickupName"></span></span>
                            <span x-show="c.dropoffName" class="text-orange-300/70"> · ↓ <span x-text="c.dropoffName"></span></span>
                          </div>
                        </template>
                      </div>
                    </div>
                  </template>
                  <div x-show="(current.manifests || []).length === 0" class="text-white/55 italic">— aucune ligne —</div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- FLOATING DROPDOWN (PORTAL) -->
        <div
          x-show="floatDd.open"
          x-cloak
          class="fixed z-[9999]"
          :style="`left:${floatDd.x}px; top:${floatDd.y}px; width:${floatDd.w}px;`"
          @keydown.escape.window="closeFloat()"
          @keydown.arrow-down.window="if (floatDd.open) { $event.preventDefault(); floatDdIndex = Math.min(floatDdIndex + 1, (floatDd.results || []).length - 1) }"
          @keydown.arrow-up.window="if (floatDd.open) { $event.preventDefault(); floatDdIndex = Math.max(floatDdIndex - 1, 0) }"
          @keydown.enter.window="if (floatDd.open && (floatDd.results || []).length > 0) { const item = floatDd.results[floatDdIndex >= 0 ? floatDdIndex : 0]; if (floatDd.kind === 'poi') selectFloatPoi(item); else if (floatDd.kind === 'commodity') selectFloatCommodity(item); else if (floatDd.kind === 'ship') selectFloatShip(item); }"
          @mousedown.outside="closeFloat()"
        >
          <div class="rounded-xl border border-white/10 bg-[#0b1422]/95 backdrop-blur-sm shadow-2xl overflow-hidden">
            <div x-show="floatDd.loading" class="px-3 py-2 text-sm text-white/55">Recherche…</div>

            <!-- POI results -->
            <template x-if="floatDd.kind === 'poi'">
              <div class="max-h-60 overflow-y-auto p-2 space-y-1">
                <template x-for="(poi, idx) in (floatDd.results || [])" :key="poi.id">
                  <button
                    @mousedown.prevent="selectFloatPoi(poi)"
                    :class="idx === floatDdIndex ? 'bg-sky-400/20 border-sky-400/30' : 'border-transparent hover:bg-sky-400/10 hover:border-sky-400/20'"
                    class="w-full text-left px-3 py-2 rounded-lg border transition"
                  >
                    <div class="flex items-center justify-between gap-2">
                      <div class="text-sm font-semibold text-white/90" x-text="getPoiDisplayName(poi)"></div>
                      <span class="text-xs px-2 py-0.5 rounded-full bg-white/10 text-white/60" x-text="getPoiTypeLabel(poi)"></span>
                    </div>
                  </button>
                </template>

                <div x-show="(floatDd.results || []).length === 0 && !floatDd.loading" class="px-3 py-2 text-sm text-white/55 italic">
                  Aucun résultat.
                </div>
              </div>
            </template>

            <!-- Commodity results -->
            <template x-if="floatDd.kind === 'commodity'">
              <div class="max-h-60 overflow-y-auto p-2 space-y-1">
                <template x-for="(c, idx) in (floatDd.results || [])" :key="c.id">
                  <button
                    @mousedown.prevent="selectFloatCommodity(c)"
                    :class="idx === floatDdIndex ? 'bg-sky-400/20 border-sky-400/30' : 'border-transparent hover:bg-sky-400/10 hover:border-sky-400/20'"
                    class="w-full text-left px-3 py-2 rounded-lg border transition"
                  >
                    <div class="text-sm font-semibold text-white/90" x-text="c.name"></div>
                  </button>
                </template>

                <div x-show="(floatDd.results || []).length === 0 && !floatDd.loading" class="px-3 py-2 text-sm text-white/55 italic">
                  Aucun résultat.
                </div>
              </div>
            </template>
            <!-- Ship results -->
            <template x-if="floatDd.kind === 'ship'">
              <div class="max-h-60 overflow-y-auto p-2 space-y-1">
                <template x-for="(s, idx) in (floatDd.results || [])" :key="s.id">
                  <button
                    @mousedown.prevent="selectFloatShip(s)"
                    :class="idx === floatDdIndex ? 'bg-sky-400/20 border-sky-400/30' : 'border-transparent hover:bg-sky-400/10 hover:border-sky-400/20'"
                    class="w-full text-left px-3 py-2 rounded-lg border transition"
                  >
                    <div class="text-sm font-semibold text-white/90" x-text="s.name"></div>
                    <div class="text-xs text-white/45" x-text="s.specification?.scu ? ('SCU: ' + s.specification.scu) : ''"></div>
                  </button>
                </template>

                <div x-show="(floatDd.results || []).length === 0 && !floatDd.loading" class="px-3 py-2 text-sm text-white/55 italic">
                  Aucun vaisseau trouvé.
                </div>
              </div>
            </template>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}