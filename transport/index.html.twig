          >Infos</button>

          <button
            @click="editTab='lines'"
            :class="editTab==='lines' ? 'bg-sky-400/15 border-sky-400/30 text-sky-100' : 'bg-white/5 border-white/10 text-white/70 hover:bg-white/10'"
