{% extends 'base.html.twig' %}

{% block title %}Marché · Ordres de transport{% endblock %}

{% block jsAlpine %}
  <script>
    window.TRANSPORT_MERCURE = {
      hubUrl: {{ mercureHubUrl|json_encode|raw }},
      topic:  {{ mercureTopic|json_encode|raw }},
    };
  </script>
  {{ encore_entry_script_tags('transport') }}
{% endblock %}

{% block body %}
<section class="max-w-[100rem] w-full mx-auto py-10 px-6 lg:px-10">

  <!-- Header -->
  <div class="mb-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-white">
          Ordres de transport
          <span class="text-sky-300">·</span>
          <span class="text-white/70">Transport</span>
        </h1>
        <p class="mt-1 text-sm text-white/55">
          Console logistique 1CC — création, édition, lignes de livraison et génération de routes.
        </p>
      </div>

    </div>
  </div>

  <!-- Main HUD container -->
  <div
    x-data="deliveryPage()"
    x-cloak
    @keydown.ctrl.enter.window="if (tab === 'edit') saveDelivery()"
    class="relative overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-b from-[#0b1422]/90 to-[#070c14]/90 shadow-[0_0_0_1px_rgba(255,255,255,0.04),0_20px_80px_rgba(0,0,0,0.55)]"
  >
    <!-- Scanline / glow -->
    <div class="pointer-events-none absolute inset-0 opacity-[0.12] bg-[linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[length:100%_22px]"></div>
    <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full bg-sky-400/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-24 w-80 h-80 rounded-full bg-emerald-400/10 blur-3xl"></div>

    <div class="relative p-6 md:p-7">

      <!-- Top strip -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-sky-500/10 border border-sky-400/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-sky-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17H3V5h10v4m-4 8a2 2 0 104 0 2 2 0 00-4 0m8 0a2 2 0 104 0 2 2 0 00-4 0m1-4h-5V9h3l3 4z" />
            </svg>
          </div>
          <div>
            <div class="text-sm text-white/55">Module</div>
            <div class="font-semibold tracking-wide">LOGISTICS / TRANSPORT ORDERS</div>
          </div>
        </div>
      </div>

      <!-- Tabs + actions -->
      <div class="mb-6 flex flex-wrap items-center gap-2">
        <button
          @click="goToList()"
          :class="tab==='list' ? 'bg-sky-400/15 border-sky-400/30 text-sky-100' : 'bg-white/5 border-white/10 text-white/70 hover:bg-white/10'"
          class="px-4 py-2 rounded-xl border text-sm font-semibold transition"
        >Ordres</button>

        <button
          x-show="showResultsTab"
          @click="tab='results'"
          :class="tab==='results' ? 'bg-sky-400/15 border-sky-400/30 text-sky-100' : 'bg-white/5 border-white/10 text-white/70 hover:bg-white/10'"
          class="px-4 py-2 rounded-xl border text-sm font-semibold transition"
        >Ordre généré (lecture)</button>

        <button
          x-show="allowEditTab || tab==='edit'"
          @click="tab='edit'"
          :class="tab==='edit' ? 'bg-sky-400/15 border-sky-400/30 text-sky-100' : 'bg-white/5 border-white/10 text-white/70 hover:bg-white/10'"
          class="px-4 py-2 rounded-xl border text-sm font-semibold transition"
        >Créer / Modifier</button>

        <div class="flex-1"></div>

        <button
          x-show="tab==='list'"
          @click="refreshAll()"
          class="px-4 py-2 rounded-xl font-semibold text-white/90 bg-white/5 border border-white/10 hover:bg-white/10"
        >Rafraîchir</button>

        <button
          x-show="tab==='list'"
          @click="newDelivery()"
          class="inline-flex items-center gap-2 rounded-xl px-4 py-2 font-semibold text-[#071018]
                 bg-gradient-to-r from-sky-400 to-emerald-300 hover:brightness-110 active:brightness-95
                 shadow-[0_10px_30px_rgba(56,189,248,0.15)]"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Nouvel ordre
        </button>
      </div>

      <!-- LIST TAB -->
      <div x-show="tab==='list'" x-transition>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.03)]">
          <div class="flex items-center justify-between mb-4 gap-3">
            <h3 class="font-semibold tracking-wide">Liste des ordres de transport</h3>

            <div class="flex items-center gap-2">
              <input
                type="text"
                x-model="filters.q"
                placeholder="Rechercher…"
                class="w-56 max-w-full rounded-xl bg-[#070c14]/70 border border-white/10 px-3 py-2 text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-sky-400/30 focus:border-sky-400/30"
              >
              <span class="text-[11px] px-2 py-1 rounded-full bg-white/5 border border-white/10 text-white/70"
                    x-text="(filteredDeliveries ? filteredDeliveries().length : 0) + ' item(s)'"></span>
            </div>
          </div>

          <div x-show="loading.deliveries" class="text-white/60 text-sm mb-3">
            Chargement des ordres…
          </div>
          <div x-show="errors.deliveries" class="text-red-200 text-sm mb-3">
            <span class="font-semibold">Erreur:</span> <span x-text="errors.deliveries"></span>
          </div>

          <div class="max-h-[75vh] overflow-y-auto pr-2 space-y-2">
            <template x-for="d in (filteredDeliveries ? filteredDeliveries() : [])" :key="d.id">
              <div class="group rounded-xl border border-white/10 bg-[#070c14]/60 px-4 py-3 flex items-center justify-between gap-3 hover:border-sky-400/30 hover:bg-[#070c14]/75 transition">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <div class="font-semibold truncate" x-text="d.name || ('Ordre #' + d.id)"></div>
                  </div>

                  <div class="mt-1 text-xs text-white/55 flex flex-wrap gap-x-4 gap-y-1">
                    <span class="inline-flex items-center gap-1">
                      <span class="text-white/35">Départ:</span>
                      <span class="text-white/75" x-text="d.originNameDisplay || d.originName || '—'"></span>
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <span class="text-white/35">Vaisseaux:</span>
                      <span class="text-white/75" x-text="(d.shipModelIds?.length || d.ships?.length || 0)"></span>
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <span class="text-white/35">Lignes:</span>
                      <span class="text-white/75" x-text="(d.manifests?.length || 0)"></span>
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <span class="text-white/35">Généré:</span>
                      <span class="text-white/75" x-text="d.itinerary?.generatedAt || d.generatedAt || '—'"></span>
                      <span x-show="d.itinerary?.obsolete" class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-[11px] bg-red-600/10 border border-red-600/20 text-red-300">
                        Obsolète
                      </span>
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <template x-if="!d.itinerary">
                    <div class="flex items-center gap-2">
                      <button
                        @click="editDelivery(d)"
                        class="px-3 py-1.5 rounded-lg font-semibold text-white/90 bg-white/5 border border-white/10 hover:bg-white/10"
                      >Modifier</button>

                      <button
                        @click="duplicateDelivery(d)"
                        class="px-3 py-1.5 rounded-lg font-semibold text-white/90 bg-sky-400/10 border border-sky-400/20 hover:bg-sky-400/15"
                        title="Créer une copie de cet ordre"
                      >Dupliquer</button>

                      <button
                        @click="editDelivery(d); generateDelivery()"
                        class="px-3 py-1.5 rounded-lg font-semibold text-[#071018] bg-emerald-300 hover:brightness-110 active:brightness-95"
                      >Générer</button>
                    </div>
                    <div class="flex items-center justify-end">
                      <button
                        @click="removeManifest(idx)"
                        class="px-3 py-1.5 rounded-lg font-semibold text-white/90 bg-red-600/80 hover:bg-red-600 active:bg-red-700"
                      >Suppr</button>
                    </div>
                  </template>

                  <template x-if="d.itinerary">
                    <div class="flex items-center gap-2">
                      <button
                        @click="duplicateDelivery(d)"
                        class="px-3 py-1.5 rounded-lg font-semibold text-white/90 bg-sky-400/10 border border-sky-400/20 hover:bg-sky-400/15"
                        title="Créer une copie de cet ordre comme brouillon"
                      >Dupliquer</button>
                      <button
                        @click="viewDelivery(d)"
                        class="px-3 py-1.5 rounded-lg font-semibold text-[#071018] bg-emerald-300 hover:brightness-110 active:brightness-95"
                      >Consulter</button>
                    </div>
                  </template>

                  <button
                    @click="deleteDelivery(d.id)"
                    class="px-3 py-1.5 rounded-lg font-semibold text-white/90 bg-red-600/80 hover:bg-red-600 active:bg-red-700"
                  >Suppr</button>
                </div>
              </div>
            </template>

            <div x-show="!loading.deliveries && (filteredDeliveries ? filteredDeliveries().length === 0 : true)"
                 class="text-white/55 italic border border-dashed border-white/10 rounded-xl p-4 bg-white/[0.02]">
              Aucun ordre de transport.
            </div>
          </div>
        </div>
      </div>

      <!-- RESULTS TAB -->
<div x-show="tab==='results'" x-transition>
  <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.03)]">
    <div class="flex items-start justify-between gap-3 mb-4">
      <div>
        <h3 class="font-semibold tracking-wide">Ordre généré (lecture seule)</h3>
        <div class="text-xs text-white/50">Exécution guidée : ordre global par défaut, regroupements optionnels.</div>
      </div>

      <div class="flex items-center gap-2">
        <button
          @click="goToList()"
          class="px-3 py-1.5 rounded-lg font-semibold text-white/90 bg-white/5 border border-white/10 hover:bg-white/10"
        >Retour</button>

        <button
          @click="editFromView()"
          class="px-3 py-1.5 rounded-lg font-semibold text-[#071018] bg-sky-300 hover:brightness-110 active:brightness-95"
          title="Basculer en modification"
        >Modifier</button>
      </div>
    </div>

    <div x-show="loading.view" class="text-white/60 text-sm mb-3">Chargement de l'ordre…</div>
    <div x-show="errors.view" class="text-red-200 text-sm mb-3">
      <span class="font-semibold">Erreur:</span> <span x-text="errors.view"></span>
    </div>

    <!-- Meta -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-5">
      <div class="rounded-xl border border-white/10 bg-[#070c14]/55 p-3 text-center">
        <div class="text-[11px] text-white/45 uppercase tracking-wider">Ordre</div>
        <div class="mt-2 text-2xl font-semibold truncate" x-text="viewModel.name || ('Ordre #' + (viewModel.id ?? '—'))"></div>
      </div>

      <div class="rounded-xl border border-white/10 bg-[#070c14]/55 p-3 text-center">
        <div class="text-[11px] text-white/45 uppercase tracking-wider">Départ</div>
        <div class="mt-2 text-2xl font-semibold truncate" x-text="viewModel.originName || '—'"></div>
        <div class="mt-1 text-xs text-white/55">
          Généré: <span class="text-white/75" x-text="viewModel.itinerary?.generatedAt || viewModel.generatedAt || '—'"></span>
          <span x-show="viewModel.itinerary?.obsolete" class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-[11px] bg-red-600/10 border border-red-600/20 text-red-300">
            Génération obsolète
          </span>
        </div>
      </div>

      <div class="rounded-xl border border-white/10 bg-[#070c14]/55 p-3 text-center">
        <div class="text-[11px] text-white/45 uppercase tracking-wider">Résumé itinéraire</div>
        <div class="mt-2 text-xs text-white/60 grid grid-cols-2 gap-2">
          <div>Vaisseaux:<br><span class="text-white/80 font-semibold" x-text="(viewModel.ships?.length || 0)"></span></div>
          <div>Trajets:<br><span class="text-white/80 font-semibold" x-text="(viewModel.manifests?.length || 0)"></span></div>

          <div>Opérations:<br>
            <span class="text-white/80 font-semibold"
                  x-text="(viewModel.itinerary?.lines || []).reduce((acc,l)=> acc + ((l.manifests || l.cargos || []).length), 0)"></span>
          </div>

          <div>Quantités:<br>
            <span class="text-white/80 font-semibold" x-text="viewModel.cargoTot + ' SCU'"></span>
          </div>

          <div class="col-span-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] border"
                  :class="viewModel.itinerary?.obsolete
                    ? 'bg-red-600/10 border-red-600/20 text-red-300'
                    : 'bg-emerald-600/10 border-emerald-400/20 text-emerald-300'"
                  x-text="viewModel.itinerary?.obsolete ? 'Obsolète' : 'Valide'"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick ops -->
    <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4 mb-5">
      <div class="flex items-center justify-between gap-3">
        <div>
          <div class="text-sm font-semibold text-white/85">Points à faire</div>
          <div class="text-xs text-white/45">Checklist courte avant exécution.</div>
        </div>
        <span class="text-[11px] px-2 py-1 rounded-full bg-white/5 border border-white/10 text-white/70">OPS</span>
      </div>

      <div class="mt-3 grid grid-cols-1 md:grid-cols-3 gap-2 text-sm">
        <div class="flex items-start gap-3 rounded-xl border border-white/10 bg-[#070c14]/45 p-3">
          <div class="mt-0.5 h-6 w-6 rounded-lg bg-sky-500/10 border border-sky-400/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-sky-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2" />
            </svg>
          </div>
          <div class="min-w-0">
            <div class="font-semibold text-white/85">Préparer la flotte</div>
            <div class="text-xs text-white/55">Équipages, capacité, config.</div>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-white/10 bg-[#070c14]/45 p-3">
          <div class="mt-0.5 h-6 w-6 rounded-lg bg-emerald-500/10 border border-emerald-400/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-emerald-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div class="min-w-0">
            <div class="font-semibold text-white/85">Exécuter dans l'ordre</div>
            <div class="text-xs text-white/55">Étape 1 → 2 → 3…</div>
          </div>
        </div>

        <div class="flex items-start gap-3 rounded-xl border border-white/10 bg-[#070c14]/45 p-3">
          <div class="mt-0.5 h-6 w-6 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-3-3v6" />
            </svg>
          </div>
          <div class="min-w-0">
            <div class="font-semibold text-white/85">Tracer incidents</div>
            <div class="text-xs text-white/55">Stock, danger, détour.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Flotte -->
    <div class="rounded-2xl border border-white/10 bg-[#070c14]/55 p-3 mb-5">
      <div class="text-xs text-white/45 uppercase tracking-wider">Flotte</div>
      <div class="mt-2 max-h-[30vh] overflow-y-auto pr-2 space-y-2">
        <template x-for="(ship, idx) in (viewModel.ships || [])" :key="idx + '_' + ship.shipId">
          <div class="text-sm text-white/65 border border-white/10 rounded-lg p-2 bg-white/[0.02]">
            <div class="font-semibold text-white/80" x-text="shipModelName(ship.shipId)"></div>
            <div x-show="ship.note" class="mt-1 text-white/55 italic" x-text="'Note: ' + ship.note"></div>
          </div>
        </template>
        <div x-show="(viewModel.ships || []).length === 0" class="text-white/55 italic">
          — aucun vaisseau —
        </div>
      </div>
    </div>

    <!-- Itinerary -->
    <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-4">
      <!-- Itinéraire ruban -->
      <div class="mb-3 rounded-xl border border-white/10 bg-[#070c14]/55 px-3 py-2">
        <div class="text-[11px] text-white/45 uppercase tracking-wider mb-1">Itinéraire</div>
        <div class="flex items-center gap-2 overflow-x-auto whitespace-nowrap pr-2 justify-center">
          <template x-for="(p, i) in routeList()" :key="'rt_'+i">
            <div class="inline-flex items-center gap-2">
              <span class="text-[11px] px-2 py-1 rounded-full bg-white/5 border border-white/10 text-white/75" x-text="p"></span>
              <span x-show="i < routeList().length-1" class="text-white/25">→</span>
            </div>
          </template>
          <span x-show="routeList().length === 0" class="text-xs text-white/45 italic">— aucun trajet —</span>
        </div>
      </div>

      <!-- Header + modes -->
      <div class="mb-3 space-y-2">
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <h4 class="text-sm font-semibold text-white/80">Étapes de l'itinéraire</h4>

          <div class="flex items-center gap-2 shrink-0 flex-wrap">
            <!-- Opportunités de commerce -->
            <label class="inline-flex items-center gap-2 cursor-pointer select-none">
              <span class="text-[11px] text-white/50">Opportunités</span>
              <span class="relative inline-flex h-4 w-8 shrink-0">
                <input type="checkbox" class="sr-only peer"
                  x-model="viewModel.autoFillCargo"
                  @change="viewModel.autoFillCargo ? fetchTradeSuggestionsForView(viewModel.itinerary) : (viewModel.itinerary?.lines || []).forEach(l => l.tradeSuggestions = [])"
                >
                <span class="absolute inset-0 rounded-full bg-white/15 peer-checked:bg-sky-400 transition-colors"></span>
                <span class="absolute top-0.5 left-0.5 h-3 w-3 rounded-full bg-white shadow transition-transform peer-checked:translate-x-4"></span>
              </span>
            </label>

            <div x-show="viewModel.autoFillCargo" class="flex items-center gap-2">
                <div class="flex items-center gap-1">
                  <input
                    type="number" min="0" step="1000"
                    x-model.number="viewModel.startingCredits"
                    @input="debounceFetchTradeOpp()"
                    class="w-32 rounded-lg bg-[#070c14]/70 border border-white/10 px-2 py-1 text-white text-xs focus:outline-none focus:ring-1 focus:ring-sky-400/40"
                    placeholder="Budget cr"
                  >
                  <span class="text-[10px] text-white/35">cr</span>
                </div>

                <button
                  @click="fetchTradeSuggestionsForView(viewModel.itinerary)"
                  class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[11px] font-semibold bg-sky-500/15 border border-sky-400/25 text-sky-200 hover:bg-sky-500/20"
                >
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                  Calc.
                </button>

                <button
                  @click="showTradeOpp = !showTradeOpp"
                  :class="showTradeOpp ? 'text-sky-300 border-sky-400/20 bg-sky-500/10' : 'text-white/35 border-white/10 bg-white/5'"
                  class="px-2 py-1 rounded-lg text-[11px] border"
                  x-text="showTradeOpp ? 'Visible' : 'Masqué'"
                ></button>
              </div>

            <div class="inline-flex rounded-xl border border-white/10 bg-white/[0.03] overflow-hidden">
              <button @click="viewMode='order'"
                      :class="viewMode==='order' ? 'bg-sky-400/15 text-sky-100' : 'text-white/70 hover:bg-white/5'"
                      class="px-3 py-1.5 text-xs font-semibold">Ordre</button>
              <button @click="viewMode='from'"
                      :class="viewMode==='from' ? 'bg-sky-400/15 text-sky-100' : 'text-white/70 hover:bg-white/5'"
                      class="px-3 py-1.5 text-xs font-semibold">Par escale</button>
              <button @click="viewMode='to'"
                      :class="viewMode==='to' ? 'bg-sky-400/15 text-sky-100' : 'text-white/70 hover:bg-white/5'"
                      class="px-3 py-1.5 text-xs font-semibold">Par destination</button>
            </div>

            <span class="text-[11px] px-2 py-1 rounded-full bg-white/5 border border-white/10 text-white/70"
                  x-text="sortedLines().length + ' trajet(s)'"></span>
          </div>
        </div>
      </div>

      <div class="max-h-[60vh] overflow-y-auto space-y-2 pr-1">

        <!-- ORDER VIEW -->
        <template x-if="viewMode==='order'">
          <div class="space-y-2">
            <template x-for="(line, idx) in sortedLines()" :key="line.legId || line.id || line._k || idx">
              <div class="rounded-xl border border-white/10 bg-white/[0.01] overflow-hidden">
                <div x-data="{
                       fromName(){ return line.fromName || line.pickupNameDisplay || line.pickupName || '—' },
                       fromSystem(){ return line.fromSystemName || line.pickupSystemName || '' },
                       toName(){ return line.toName || line.dropoffNameDisplay || line.dropoffName || null },
                       toSystem(){ return line.toSystemName || line.dropoffSystemName || '' },
                       step(){ return line.orderIndex ?? '—' },

                       ops(){ return (line.cargos || line.manifests || []) },
                       unloadOps(){ return this.ops().filter(m => m.action === 'unload') },
                       loadOps(){ return this.ops().filter(m => !m.action || m.action === 'load') },
                       sum(arr){ return (arr||[]).reduce((s,m)=> s + (Number(m.quantity)||0), 0) },
