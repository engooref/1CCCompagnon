{
  "name": "1cc-electron-overlay",
  "version": "0.8.0-draft",
  "description": "Compagnon pour le jeu 1er Corps Colonial",
  "author": "Engooref",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "release": "npm run build && npm run build:native && electron-builder --win nsis",
    "build:native": "node scripts/build-native.js"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "axios": "^1.8.2",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.3",
    "keytar": "^7.9.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.1",
    "uiohook-napi": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.27",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^2.0.3",
    "electron-vite": "^3.0.0",
    "node-addon-api": "^8.3.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "fr.1ercorpscolonial.app",
    "productName": "1CC Compagnon",
    "copyright": "Copyright © 2026 1er Corps Colonial",
    "artifactName": "${productName}-${version}-setup.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/build/Release/sc_overlay_tracker.node",
        "to": "."
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.1ercorpscolonial.fr/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "selectPerMachineByDefault": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "1CC Compagnon",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
